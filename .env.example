# Copy to .env. Compose overrides hostnames for in-network use; these are host-side values.
DATABASE_URL=postgresql+asyncpg://qr:qr@localhost:55432/qr
REDIS_URL=redis://localhost:56379/0
LOG_LEVEL=INFO

# API process model and DB pool (per worker; workers * (pool + overflow) must stay under Postgres max_connections=100)
API_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

POSTGRES_USER=qr
POSTGRES_PASSWORD=qr
POSTGRES_DB=qr

DEEPSEEK_API_KEY=

# Chatbot (Phase 5). All optional; these are the defaults (api/app/chat/settings.py).
# CHAT_THINKING: off|low|high · CHAT_MENU_CONTEXT: none|index|full · CHAT_ANSWER_CACHE: off|shadow|on · CHAT_STRICT_TOOLS=true uses the /beta URL
CHAT_MODEL=deepseek-flash
CHAT_JUDGE_MODEL=deepseek-v4-pro
CHAT_THINKING=off
CHAT_TEMPERATURE=0
CHAT_MAX_TOKENS=600
CHAT_MAX_LLM_CALLS=4
CHAT_TURN_DEADLINE_S=30
CHAT_CONNECT_TIMEOUT_S=5
CHAT_READ_TIMEOUT_S=20
CHAT_RETRIES=2
CHAT_STRICT_TOOLS=false
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MENU_CONTEXT=none
CHAT_ABSTAIN_SIGNAL=true
CHAT_ABSTAIN_THRESHOLD=-3.25
CHAT_SEARCH_MENU_K=8
CHAT_SEARCH_INFO_K=10
CHAT_INFO_CONTEXT_TOKENS=1024
CHAT_HISTORY_TURNS=6
CHAT_ANSWER_CACHE=off
CHAT_ANSWER_CACHE_THRESHOLD=0.95
CHAT_SESSION_TURN_LIMIT=20
CHAT_TABLE_TURNS_PER_HOUR=60
CHAT_DAILY_BUDGET_USD=1.0
CHAT_DEBUG=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
