# Copy to .env. Compose overrides hostnames for in-network use; these are host-side values.
DATABASE_URL=postgresql+asyncpg://qr:qr@localhost:55432/qr
REDIS_URL=redis://localhost:56379/0
LOG_LEVEL=INFO

# API process model and DB pool (per worker; workers * (pool + overflow) must stay under Postgres max_connections=100)
API_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

POSTGRES_USER=qr
POSTGRES_PASSWORD=qr
POSTGRES_DB=qr

DEEPSEEK_API_KEY=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
