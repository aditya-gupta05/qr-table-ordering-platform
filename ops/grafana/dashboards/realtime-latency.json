        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(order_create_seconds_bucket[1m])))",
          "legendFormat": "order_create p95 (price + insert + commit)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(order_event_publish_seconds_bucket[1m])))",
          "legendFormat": "order_event_publish p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "order_create_seconds ends at commit; order_event_publish_seconds is the Redis PUBLISH call.",
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Go fan-out p95 (Redis receive to enqueued for all recipients)",
      "datasource": {
        "type": "prometheus",
